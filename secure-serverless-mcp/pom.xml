<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example.securemcp</groupId>
    <artifactId>secure-serverless-mcp</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>secure-serverless-mcp</name>
    <description>学习 Cognito、API Gateway、Java Lambda 与官方 MCP SDK 的本地 E2E 实验</description>

    <modules>
        <module>mcp-server-lambda</module>
        <module>mcp-client-cli</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <aws.sdk.version>2.31.27</aws.sdk.version>
        <mcp.sdk.version>2.0.1</mcp.sdk.version>
        <serverless.container.version>2.1.5</serverless.container.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
